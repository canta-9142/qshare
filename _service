<services>
  <service name="obs_scm">
    <param name="url">https://github.com/canta-9142/qshare.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="filename">qshare</param>
    <param name="versionformat">0.5.0</param>
    <param name="extract">qshare.spec</param>
