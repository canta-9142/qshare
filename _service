<services>
  <service name="tar_scm">
    <param name="url">https://github.com/canta-9142/qshare.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="filename">qshare</param>
    <param name="versionformat">0.6.1</param>
    <param name="extract">PKGBUILD</param>
    <param name="extract">qshare.spec</param>
    <param name="extract">qshare.dsc</param>
    <param name="extract">debian.changelog</param>
    <param name="extract">debian.control</param>
    <param name="extract">debian.copyright</param>
    <param name="extract">debian.rules</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="go_modules"/>
</services>
